// secrets.h.example -- template public. Copie en secrets.h et remplis.
// secrets.h est gitignored, ne JAMAIS le committer.

#ifndef RAYCASH_SECRETS_H
#define RAYCASH_SECRETS_H

// Wi-Fi LAN du laptop qui heberge Flask
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// IP/port du PC (visible dans le moniteur serie au boot de Flask)
#define SERVER_URL     "http://192.168.1.100:5000/esp_signal"

// Doit correspondre a RAYCASH_API_KEY cote server/.env
#define RAYCASH_API_KEY "change-me"

// Doit correspondre a RAYCASH_HMAC_SECRET cote server/.env
// Si la valeur cote serveur est vide, mettre "" ici aussi (mode degrade : pas
// de signature, anti-rejeu desactive).
#define RAYCASH_HMAC_SECRET "change-me-hex"

#endif
