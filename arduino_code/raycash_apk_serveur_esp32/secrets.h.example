// secrets.h.example — Template public, copie ce fichier vers secrets.h et remplis-le.
// `secrets.h` est ignoré par git pour ne jamais committer d'identifiants.

#ifndef RAYCASH_SECRETS_H
#define RAYCASH_SECRETS_H

#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// IP/port du PC qui héberge le serveur Flask
#define SERVER_URL     "http://192.168.1.100:5000/esp_signal"

// Doit correspondre à RAYCASH_API_KEY côté serveur (.env)
#define RAYCASH_API_KEY "change-me"

#endif
