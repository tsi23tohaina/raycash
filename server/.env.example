# Copie ce fichier en .env (le .env est ignoré par git) et adapte les valeurs.

# Bind du serveur
HOST=0.0.0.0
PORT=5000

# --- Tunnel HTTPS public (V2) ---
# URL publique du tunnel HTTPS (cloudflared / ngrok / reverse proxy).
# Utilisée par /pair pour générer le QR code avec une URL HTTPS accessible
# depuis le téléphone (HTTPS requis pour getUserMedia côté browser).
# - Laisse vide en LAN pur (la détection auto via cloudflared prend le relais).
# - Si renseignée, écrase la détection auto (utile derrière nginx/ngrok perso).
PUBLIC_URL=

# Lance cloudflared automatiquement au boot du serveur et capture l'URL HTTPS
# dynamique. Évite de mettre à jour PUBLIC_URL à chaque restart.
# Pré-requis : `cloudflared` doit être dans le PATH (voir requirements.txt).
AUTO_TUNNEL=true

# Chemin custom vers le binaire cloudflared (optionnel, par défaut PATH).
CLOUDFLARED_PATH=

# Timeout (s) pour la capture de l'URL HTTPS au démarrage de cloudflared.
AUTO_TUNNEL_TIMEOUT=30

# Adresse de l'ESP32 (route /servo) — visible dans le moniteur série Arduino
ESP32_IP=http://192.168.1.42
ESP32_TIMEOUT_SECONDS=2

# Clé API partagée. Doit être identique côté Flutter et côté Arduino (secrets.h).
# Génère une valeur aléatoire, par ex. python -c "import secrets; print(secrets.token_urlsafe(32))"
RAYCASH_API_KEY=change-me-dev-key

# Secret HMAC pour signer les requêtes /esp_signal (anti-rejeu).
# Si vide, HMAC est désactivé (mode rétro-compat). Génère :
# python -c "import secrets; print(secrets.token_hex(32))"
RAYCASH_HMAC_SECRET=
HMAC_MAX_SKEW_SECONDS=60

# Origines autorisées pour CORS et Socket.IO, séparées par des virgules.
# Exemple LAN dev : http://localhost:5000,http://10.0.2.2:5000
# Mettre * NE doit JAMAIS apparaître en production.
ALLOWED_ORIGINS=http://localhost:5000

# Limites d'upload
MAX_UPLOAD_BYTES=5242880      # 5 MiB
MAX_IMAGE_DIMENSION=4096      # px max par côté

# Seuil de confiance minimum pour accepter une classification
CONFIDENCE_THRESHOLD=0.45

# Rate limiting (flask-limiter), syntaxe "N per period"
RATE_LIMIT_PREDICT=30 per minute
RATE_LIMIT_ESP_SIGNAL=60 per minute

# Nettoyage des uploads/ : garde au plus N fichiers, rien de plus vieux que X secondes,
# passe toutes les Y secondes (job background dans un thread démon).
CLEANUP_MAX_FILES=500
CLEANUP_MAX_AGE_SECONDS=604800
CLEANUP_INTERVAL_SECONDS=3600

# --- Backend de classification ---
# - "local"  : modèles TFLite (ensemble V4 ou Classifier V3 selon ENSEMBLE_ENABLED)
# - "gemini" : Google Gemini 2.5 Flash Vision (~95% accuracy, internet requis)
#              Free tier : 1500 req/jour. Récupère ta clé sur :
#              https://aistudio.google.com/apikey
CLASSIFIER_BACKEND=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ensemble V4 (raycash-pro) ---
# Active le vote multi-modèles + uncertainty quantification.
# Si false, fallback sur Classifier mono-modèle (model_path).
ENSEMBLE_ENABLED=true
ENSEMBLE_DIR=models/ensemble
ENSEMBLE_LABEL_PATH=models/ensemble/labels.txt

# Seuils de rejet (cf. notebook V4 cellule 7) :
# - min_confidence : max_prob du softmax moyen doit être >= X
# - max_entropy    : entropie du softmax moyen doit être <= X
# - max_disagreement : écart-type inter-modèles doit être <= X
# Avec 0.70 : ~98% acc sur acceptés, ~83% taux d'acceptation
# Avec 0.85 : ~99% acc sur acceptés, ~68% taux d'acceptation
ENSEMBLE_MIN_CONFIDENCE=0.70
ENSEMBLE_MAX_ENTROPY=1.5
ENSEMBLE_MAX_DISAGREEMENT=0.20

# Multi-vue : nombre max d'images dans une requête /predict
ENSEMBLE_MAX_IMAGES=5
